# Spring Boot
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false

# MCP Configuration
spring.ai.mcp.servers.classroom.enable=true
spring.ai.mcp.servers.classroom.type=stdio

# Logging
logging.level.root=INFO
logging.level.com.classroom=DEBUG

# Application
app.data.excel-dir=./exports
app.data.database.file-path=./data/classroom_mcp_db
